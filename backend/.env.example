# ---- database (MySQL 8 or MariaDB 10.5+) ----
# Either one URL ...
DATABASE_URL=mysql://mgauto:change-me@127.0.0.1:3306/mg_auto
# ... or separate settings (used when DATABASE_URL is empty)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=mgauto
# DB_PASSWORD=change-me
# DB_NAME=mg_auto
# Hosted MySQL usually needs TLS. DB_SSL_CA may hold the provider's CA certificate (PEM text).
# DB_SSL=true
# DB_SSL_CA=

# ---- server ----
PORT=3000
JWT_SECRET=long-random-string-at-least-16-characters
# Browser origin(s) allowed to call the API, comma separated. Not needed when the API serves the app itself.
CORS_ORIGIN=http://localhost:5173
# Serve the built React app from this API (single-host deploys, Docker). Example: ../frontend/dist
# FRONTEND_DIR=../frontend/dist

# First admin, created on the first start (password 8+ characters)
ADMIN_USER=admin
ADMIN_PASS=change-me-12345

# ---- business settings ----
LABOUR_RATE=350
# VAT as a fraction (0.15 = 15%)
VAT_RATE=0.15
GARAGE_NAME=MADEG — MG Auto
GARAGE_ADDRESS=Gurdshola, around Top Ten Hotel, Addis Ababa
GARAGE_PHONE=0980766566
GARAGE_TIN=
GARAGE_MOTTO=Your car, our care

# ---- "Vehicle ready" messages. All optional: a channel that is not set up is skipped and shown as such on the job card.
# Placeholders: {name} {plate} {jc} {phone}
# READY_MESSAGE=MG Auto: Dear {name}, your vehicle {plate} is ready (job card {jc}). Please come to collect it. Questions? Call {phone}.

# SMS (AfroMessage-style gateway). Check the URL and field names against your provider's documentation.
SMS_API_KEY=
SMS_IDENTIFIER=
SMS_SENDER=
SMS_API_URL=https://api.afromessage.com/api/send
SMS_COUNTRY_CODE=251

# Telegram: create a bot with @BotFather and paste its token. The webhook is registered automatically on start.
TELEGRAM_BOT_TOKEN=
# Public https URL of this API (Render sets RENDER_EXTERNAL_URL for you)
PUBLIC_API_URL=
