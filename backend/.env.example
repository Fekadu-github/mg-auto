SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-from-supabase-settings-api
JWT_SECRET=long-random-string
CORS_ORIGIN=https://your-site.netlify.app
ADMIN_USER=admin
ADMIN_PASS=change-me-12345

# VAT as a fraction (0.15 = 15%)
VAT_RATE=0.15

# "Vehicle ready" messages. All optional: a channel that is not set up is skipped and shown as such on the job card.
GARAGE_PHONE=0980766566
# Placeholders: {name} {plate} {jc} {phone}
# READY_MESSAGE=MG Auto: Dear {name}, your vehicle {plate} is ready (job card {jc}). Please come to collect it. Questions? Call {phone}.

# SMS (AfroMessage-style gateway). Check the URL and field names against your provider's documentation.
SMS_API_KEY=
SMS_IDENTIFIER=
SMS_SENDER=
SMS_API_URL=https://api.afromessage.com/api/send
SMS_COUNTRY_CODE=251

# Telegram: create a bot with @BotFather and paste its token. The webhook is registered automatically on start.
TELEGRAM_BOT_TOKEN=
# Public URL of this API (Render sets RENDER_EXTERNAL_URL for you, so this is usually not needed)
PUBLIC_API_URL=
